# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite is the default. Set DB_ENGINE=postgres to use PostgreSQL.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
DB_NAME=veggiedeliver
DB_USER=veggiedeliver
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=True

# SMS OTP: console, fast2sms, or msg91
SMS_BACKEND=console
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_FLOW_ID=

# WhatsApp notifications: console or msg91
WHATSAPP_BACKEND=console
WHATSAPP_FLOW_ID=
WHATSAPP_NOTIFICATIONS_ENABLED=True

# Google integrations. GOOGLE_MAPS_API_KEY is optional while Leaflet/OpenStreetMap is used.
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_API_KEY=

# Initial map center and zoom (Bhopal defaults)
MAP_DEFAULT_LATITUDE=23.2599
MAP_DEFAULT_LONGITUDE=77.4126
MAP_DEFAULT_ZOOM=12

# Add production domains, comma-separated
CSRF_TRUSTED_ORIGINS_EXTRA=